// Prisma schema for Booking Board
// Multi-tenant booking & scheduling system

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Business {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique // used in public booking URL: /b/{slug}
  description String?
  timezone    String   @default("UTC") // IANA tz e.g. "America/New_York", "Europe/London"
  ownerUserId String   @default("owner-demo")
  currency    String   @default("USD")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services     Service[]
  staff        Staff[]
  appointments Appointment[]
  customers    Customer[]
}

model Staff {
  id         String   @id @default(cuid())
  businessId String
  name       String
  email      String?
  phone      String?
  role       String?
  avatarUrl  String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  workingHours WorkingHours[]
  timeOff      StaffTimeOff[]
  appointments Appointment[]
  staffServices StaffService[]

  @@index([businessId])
}

model StaffService {
  id        String   @id @default(cuid())
  staffId   String
  serviceId String

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([staffId, serviceId])
  @@index([staffId])
  @@index([serviceId])
}

model WorkingHours {
  id       String @id @default(cuid())
  staffId  String
  weekday  Int    // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startMin Int    // minutes from midnight in business timezone (e.g. 540 = 9:00 AM)
  endMin   Int    // minutes from midnight in business timezone (e.g. 1020 = 5:00 PM)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, weekday])
}

model StaffTimeOff {
  id        String   @id @default(cuid())
  staffId   String
  startsAt  DateTime // Stored in UTC
  endsAt    DateTime // Stored in UTC
  reason    String?
  createdAt DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, startsAt])
}

model Service {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  durationMin Int      // in minutes (e.g., 30, 45, 60)
  priceCents  Int      // in cents (e.g., 3500 for $35.00)
  bufferMin   Int      @default(0) // cleanup/prep buffer after appointment
  color       String?  @default("#6366f1") // accent color for calendar/board
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments  Appointment[]
  staffServices StaffService[]

  @@index([businessId])
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  email      String?
  phone      String?
  notes      String?
  createdAt  DateTime @default(now())

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([businessId, email])
  @@index([businessId, phone])
}

// Appointment Model
// Concurrency & Double-Booking Protection:
// In PostgreSQL production, this table is protected by a database-level EXCLUDE USING gist constraint
// (see prisma/migrations/postgres_exclusion_constraint.sql) preventing overlapping ranges for the same staff member.
// In application code, all appointment creations run inside atomic prisma.$transaction locks.
model Appointment {
  id            String   @id @default(cuid())
  businessId    String
  staffId       String
  serviceId     String
  customerId    String
  startsAt      DateTime // Stored in UTC
  endsAt        DateTime // Stored in UTC
  status        String   @default("CONFIRMED") // CONFIRMED, CANCELLED, COMPLETED, NO_SHOW
  paymentStatus String   @default("NONE") // NONE, DEPOSIT_PAID, PAID, REFUNDED
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([staffId, startsAt])
  @@index([businessId, startsAt])
}
